# ── Server ──────────────────────────────────────────
PORT=5002                              # Server port
NODE_ENV=development                   # Environment: development | production

# ── Database ────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/event-booking # MONGO_URI is accepted as a legacy alias

# ── Authentication ──────────────────────────────────
JWT_SECRET=                            # JWT signing secret (min 32 chars in production)
JWT_EXPIRE=7d                          # JWT token expiration (e.g. 7d, 24h)

# ── Client ──────────────────────────────────────────
CLIENT_URL=http://localhost:5175,http://localhost:5173 # Render: use the exact Vercel origin

# ── Email (Gmail SMTP) ───────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=                            # Gmail address
EMAIL_PASS=                            # Google App Password; keep secret
EMAIL_FROM=                            # Sender address; defaults to EMAIL_USER
EMAIL_FROM_NAME=EventBooking
# Legacy names SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS and SMTP_FROM_NAME remain supported.
EMAIL_OTP_SECRET=                       # Optional dedicated OTP hashing secret; defaults to JWT_SECRET

# ── File Upload ─────────────────────────────────────
UPLOAD_MAX_SIZE=5242880                # Max upload size in bytes (default: 5MB)

# ── Manual Payment & QR Configuration ───────────────
UPI_ID=merchant@upi                    # Merchant UPI ID for receiving payments
PAYMENT_QR_URL=                        # Optional direct URL or leave empty to auto-generate UPI QR
MAX_PAYMENT_SCREENSHOT_SIZE_MB=5       # Maximum allowed screenshot size in MB

# ── Admin Seed ──────────────────────────────────────
ADMIN_SEED_EMAIL=                       # Required only when intentionally running the seed script
ADMIN_SEED_PASSWORD=                    # Set only when intentionally running the seed script
ADMIN_SEED_NAME=                        # Optional display name for the seed script
                    # Admin user display name for seed script
