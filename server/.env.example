# ── Server ──────────────────────────────────────────
PORT=5002                              # Server port
NODE_ENV=development                   # Environment: development | production

# ── Database ────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/userGame2                          # MongoDB connection string (e.g. mongodb://localhost:27017/event-booking)

# ── Authentication ──────────────────────────────────
JWT_SECRET=                            # JWT signing secret (min 32 chars in production)
JWT_EXPIRE=7d                          # JWT token expiration (e.g. 7d, 24h)

# ── Client ──────────────────────────────────────────
CLIENT_URL=http://localhost:5175,http://localhost:5173 # Frontend URLs for CORS

# ── Email (SMTP via Gmail) ─────────────────────────
SMTP_HOST=smtp.gmail.com               # Gmail SMTP host
SMTP_PORT=587                          # SMTP server port
SMTP_USER=your-email@example.com             # Gmail address (required in production)
SMTP_PASS=your-smtp-app-password          # Gmail App Password (required in production)
SMTP_FROM_NAME=EventBooking            # Sender display name
EMAIL_OTP_SECRET=                       # Optional dedicated OTP hashing secret; defaults to JWT_SECRET

# ── File Upload ─────────────────────────────────────
UPLOAD_MAX_SIZE=5242880                # Max upload size in bytes (default: 5MB)

# ── Manual Payment & QR Configuration ───────────────
UPI_ID=merchant@upi                    # Merchant UPI ID for receiving payments
PAYMENT_QR_URL=                        # Optional direct URL or leave empty to auto-generate UPI QR
MAX_PAYMENT_SCREENSHOT_SIZE_MB=5       # Maximum allowed screenshot size in MB

# ── Admin Seed ──────────────────────────────────────
ADMIN_SEED_EMAIL=admin@gmail.com        # Admin user email for seed script
ADMIN_SEED_PASSWORD=admin123                   # Admin user password for seed script
ADMIN_SEED_NAME=admin                   # Admin user display name for seed script
                    # Admin user display name for seed script
